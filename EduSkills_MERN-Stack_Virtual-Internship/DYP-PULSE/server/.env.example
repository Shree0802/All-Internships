NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/dypulse?retryWrites=true&w=majority
SESSION_SECRET=replace-with-random-64-character-string
CORS_ORIGIN=http://localhost:5173
# Cloudinary (Optional image uploads; falls back to local disk if omitted)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay Test Mode Gateway (Optional; falls back to COD if omitted)
# Generate test keys in Razorpay Dashboard > Settings > API Keys (Test Mode)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpayKeySecretHere
RAZORPAY_WEBHOOK_SECRET=yourWebhookSecretHere

# Email Notifications Service
# EMAIL_PROVIDER options: 'mock' (in-memory test logger), 'ethereal' (preview links), 'smtp' (live/staging SMTP)
EMAIL_PROVIDER=mock
EMAIL_FROM="DYPULSE Campus Store <noreply@dypulse.edu>"
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
REQUIRE_EMAIL_VERIFICATION=false
CLIENT_URL=http://localhost:5173

# Admin Initial Seed Credentials
ADMIN_EMAIL=admin@dypulse.edu
ADMIN_PASSWORD=AdminSecure@DY2026
